{
  "name": "@openstyle/workspace",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:install": "bash scripts/dev-install.sh",
    "release:local": "bash scripts/release-local.sh",
    "format": "biome check --write .",
    "knip": "knip",
    "meeting:compare": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/compare.mts",
    "meeting:check-summary": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/check-summary.mts",
    "meeting:compare-speakers": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/compare-speakers.mts",
    "meeting:eval": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/eval.mts",
    "meeting:eval:memory-recall": "node --import ./scripts/meeting-v2/ts-register.mjs --import ./scripts/meeting-v2/ts-transform.mjs scripts/meeting-v2/eval/memory-recall.mts",
    "meeting:eval:gold-draft": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/gold-draft.mts",
    "meeting:eval:gold-clips": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/gold-clips.mts",
    "meeting:eval:gold-merge": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/gold-merge.mts",
    "meeting:eval:sweep": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/sweep.mts",
    "meeting:eval:audio-verify": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/audio-verify.mts",
    "meeting:eval:screen-remote": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/screen-remote.mts",
    "meeting:eval:test": "node --import ./scripts/meeting-v2/ts-register.mjs --test scripts/meeting-v2/eval/checks.test.mts scripts/meeting-v2/eval/score.test.mts scripts/meeting-v2/eval/gold-tools.test.mts scripts/meeting-v2/eval/gpu-queue.test.mts scripts/meeting-v2/eval/seed-folder-memory.test.mts scripts/meeting-v2/eval/memory-recall-metrics.test.mts scripts/meeting-v2/eval/sweep.test.mts scripts/meeting-v2/eval/silver/score/names.test.mts scripts/meeting-v2/eval/lab/lab.test.mts",
    "lab": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/lab/lab.mts",
    "meeting:silver:witness": "python3 -I scripts/meeting-v2/eval/silver/witness/witness.py",
    "meeting:silver:parakeet": "python3 -I scripts/meeting-v2/eval/silver/witness/parakeet.py",
    "meeting:silver:align": "python3 -I scripts/meeting-v2/eval/silver/align/align_ext.py",
    "meeting:silver:vote": "python3 -I scripts/meeting-v2/eval/silver/vote/normalize_silver3.py",
    "meeting:silver:validate": "python3 -I scripts/meeting-v2/eval/silver/vote/validate_silver2.py",
    "meeting:silver:load-check": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/silver/vote/load_gold_check.mts",
    "meeting:silver:score": "python3 -I scripts/meeting-v2/eval/silver/score/score_silver.py",
    "meeting:silver:arm": "bash scripts/meeting-v2/eval/silver/score/run_arm.sh",
    "meeting:silver:arms": "bash scripts/meeting-v2/eval/silver/score/run_arms.sh",
    "meeting:silver:score-arms": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/silver/score/score_arms.mts",
    "meeting:silver:compare-arms": "python3 -I scripts/meeting-v2/eval/silver/score/compare_arms.py",
    "meeting:silver:extract-unsup": "node --import ./scripts/meeting-v2/ts-register.mjs scripts/meeting-v2/eval/silver/score/extract_unsup.mts",
    "meeting:silver:test": "python3 -I scripts/meeting-v2/eval/silver/test_silver_paths.py && python3 -I scripts/meeting-v2/eval/silver/vote/test_validate_silver.py",
    "test": "turbo test",
    "prepare": "is-ci || husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "knip": "^6.23.0",
    "nano-staged": "^1.0.2",
    "turbo": "^2.9.14"
  },
  "nano-staged": {
    "*.{ts,tsx,js,json}": "biome check --write --no-errors-on-unmatched"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1"
}
