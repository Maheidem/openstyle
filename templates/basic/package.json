{
  "name": "openstyle-plugin-starter",
  "version": "0.0.1",
  "type": "module",
  "description": "An Openstyle voice dictation plugin.",
  "license": "MIT",
  "keywords": [
    "openstyle",
    "openstyle-plugin",
    "voice",
    "dictation"
  ],
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "openstyle": {
    "displayName": "My Plugin",
    "icon": "Puzzle"
  },
  "scripts": {
    "build": "pkgroll --minify",
    "typecheck": "tsc --noEmit",
    "link": "node scripts/link-plugin.mjs",
    "unlink": "node scripts/link-plugin.mjs --unlink"
  },
  "dependencies": {
    "@openstyle/sdk": "^1.0.0"
  },
  "devDependencies": {
    "pkgroll": "^2.27.0",
    "typescript": "^5.8.3"
  }
}
