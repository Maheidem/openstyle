{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "rules": {
    // Export cleanup is a larger existing backlog. Keep the initial CI gate
    // focused on unused files, dependencies, unresolved imports, and binaries.
    "exports": "off",
    "types": "off",
    "enumMembers": "off",
    "namespaceMembers": "off"
  },
  "ignoreBinaries": [
    "cmake",
    "install_name_tool",
    "make",
    "objdump",
    "pactl",
    "pkg-config",
    "powershell",
    "powershell.exe",
    "python3"
  ],
  "ignoreFiles": [
    "apps/electron/src/preload/*.d.ts",
    // Existing unused shadcn-style components kept as design-system inventory.
    "apps/electron/src/renderer/src/components/ui/bar-visualizer.tsx",
    "apps/electron/src/renderer/src/components/ui/card.tsx",
    "apps/electron/src/renderer/src/env.d.ts",
    "plugins/audio-transcription/ui/src/styles.css",
    // Templates are standalone starter projects downloaded by create-openstyle-plugin,
    // not workspace code. They are never imported or built within the monorepo.
    "templates/**"
  ],
  "workspaces": {
    "apps/electron": {
      "entry": [
        "electron.vite.config.ts",
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/src/dashboard.tsx",
        "src/renderer/src/meeting-capture.ts",
        "src/renderer/src/components/pill.tsx",
        "src/renderer/src/components/remix-bar.tsx",
        "tests/**/*.ts",
        "scripts/**/*.{js,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx,d.ts,css}",
        "scripts/**/*.{js,mjs,ts}",
        "tests/**/*.ts",
        "*.config.ts"
      ],
      "paths": {
        "@renderer/*": ["src/renderer/src/*"],
        "@shared/*": ["src/shared/*"],
        "@openstyle/sdk": ["../../packages/sdk/src/index.ts"],
        "@openstyle/server": ["../server/src/index.ts"],
        "@openstyle/utils": ["../../packages/utils/src/index.ts"],
        "@openstyle/validations": ["../../packages/validations/src/index.ts"]
      },
      "ignoreDependencies": [
        "@hono/node-server",
        "@types/ws",
        "react-hotkeys-hook",
        "ws"
      ]
    },
    "apps/server": {
      "entry": [
        "src/startup.ts",
        "scripts/benchmark-post-process.ts",
        "scripts/tone-benchmark.ts",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "*.config.ts"
      ],
      "paths": {
        "@openstyle/sdk": ["../../packages/sdk/src/index.ts"],
        "@openstyle/utils": ["../../packages/utils/src/index.ts"],
        "@openstyle/validations": ["../../packages/validations/src/index.ts"],
        "@openstyle/stt": ["../../packages/stt/src/index.ts"]
      },
      "vitest": {
        "entry": ["tests/**/*.test.ts", "tests/setup.ts"]
      },
      "ignoreDependencies": ["@types/json-schema", "node:sqlite"]
    },
    "packages/create-openstyle-plugin": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "plugins/*": {
      "entry": ["src/index.ts", "ui/src/main.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "ui/src/**/*.{ts,tsx,css}"]
    }
  }
}
