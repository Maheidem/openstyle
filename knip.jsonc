{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "rules": {
    // Export cleanup is a larger existing backlog. Keep the initial CI gate
    // focused on unused files, dependencies, unresolved imports, and binaries.
    "exports": "off",
    "types": "off",
    "enumMembers": "off",
    "namespaceMembers": "off"
  },
  "ignoreBinaries": [
    "cmake",
    "ffmpeg",
    "install_name_tool",
    "make",
    "objdump",
    "pactl",
    "pkg-config",
    "powershell",
    "powershell.exe",
    "python3"
  ],
  "ignoreFiles": [
    // Static marketing site: loaded from site/index.html, which knip does
    // not parse for script references.
    "site/main.js",
    // Run by hand (scripts/site-captures/README.md), not imported anywhere.
    "scripts/site-captures/*.mjs",
    // Meeting transcription v2 proof scripts (specs/meeting-transcription-v2.md
    // phases 0a/0b): run manually against the isolated scratch profile, not
    // imported by any entry.
    "scripts/meeting-v2/measure-diarizer.mjs",
    "scripts/meeting-v2/metrics.mjs",
    "scripts/meeting-v2/run-baseline.mjs",
    "scripts/meeting-v2/seed-scratch-db.mjs",
    "apps/electron/src/preload/*.d.ts",
    // Kept on purpose: specs/lean-audit-2026-09.md T0-5 keeps this entry.
    "apps/electron/src/renderer/src/components/ui/card.tsx",
    "apps/electron/src/renderer/src/env.d.ts"
  ],
  "workspaces": {
    "apps/electron": {
      "entry": [
        "electron.vite.config.ts",
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/src/dashboard.tsx",
        "src/renderer/src/meeting-capture.ts",
        "src/renderer/src/components/pill.tsx",
        "src/renderer/src/components/remix-bar.tsx",
        "tests/**/*.ts",
        "scripts/**/*.{js,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx,d.ts,css}",
        "scripts/**/*.{js,mjs,ts}",
        "tests/**/*.ts",
        "*.config.ts"
      ],
      "paths": {
        "@renderer/*": ["src/renderer/src/*"],
        "@shared/*": ["src/shared/*"],
        "@openstyle/sdk": ["../../packages/sdk/src/index.ts"],
        "@openstyle/server": ["../server/src/index.ts"],
        "@openstyle/utils": ["../../packages/utils/src/index.ts"],
        "@openstyle/validations": ["../../packages/validations/src/index.ts"]
      }
    },
    "apps/server": {
      "entry": [
        "src/startup.ts",
        "scripts/benchmark-post-process.ts",
        "scripts/tone-benchmark.ts",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "*.config.ts"
      ],
      "paths": {
        "@openstyle/sdk": ["../../packages/sdk/src/index.ts"],
        "@openstyle/utils": ["../../packages/utils/src/index.ts"],
        "@openstyle/validations": ["../../packages/validations/src/index.ts"],
        "@openstyle/stt": ["../../packages/stt/src/index.ts"]
      },
      "vitest": {
        "entry": ["tests/**/*.test.ts", "tests/setup.ts"]
      },
      "ignoreDependencies": ["@types/json-schema", "node:sqlite"]
    }
  }
}
