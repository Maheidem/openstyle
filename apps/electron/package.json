{
  "name": "@openstyle/electron",
  "productName": "Openstyle",
  "desktopName": "openstyle.desktop",
  "version": "2.13.0",
  "description": "Voice-to-text that works everywhere",
  "author": "Maheidem",
  "homepage": "https://github.com/Maheidem/openstyle",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "start": "electron-vite preview",
    "compile:native": "node scripts/compile-native.js",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "analyze": "ANALYZE=1 electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run compile:native && npm run download:ffmpeg && electron-vite build && electron-builder --win --publish never",
    "build:mlx-asr-worker": "../../scripts/build_mlx_asr_worker.sh",
    "build:mac": "npm run compile:native && npm run download:ffmpeg && electron-vite build && electron-builder --mac --publish never",
    "generate:linux-icons": "python3 scripts/generate-linux-icons.py",
    "build:linux": "npm run compile:native && npm run download:ffmpeg && electron-vite build && electron-builder --linux --publish never",
    "download:ffmpeg": "node scripts/download-ffmpeg.mjs",
    "download:whisper-cpp": "node scripts/download-whisper-cpp.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.44",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@openstyle/server": "workspace:*",
    "@openstyle/utils": "workspace:*",
    "@openstyle/validations": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.4",
    "electron-updater": "^6.3.9",
    "@openstyle/sdk": "workspace:*",
    "hono": "catalog:",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^9.1.0",
    "react-router": "^7.15.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "catalog:",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup-plugin-visualizer": "^6.0.4",
    "tailwindcss": "^4.3.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
