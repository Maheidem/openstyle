{
  "name": "@openstyle/server",
  "type": "module",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && pkgroll --minify --clean-dist",
    "start": "node dist/startup.js",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "development": "./src/index.ts"
    }
  },
  "bin": {
    "openstyle-server": "./dist/startup.js"
  },
  "main": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/elevenlabs": "^2.0.33",
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/mistral": "^3.0.37",
    "@ai-sdk/openai": "^3.0.65",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-validator": "^0.8.0",
    "@huggingface/hub": "^2.13.0",
    "@openstyle/stt": "workspace:*",
    "ai": "^6.0.191",
    "diff": "^8.0.4",
    "hono": "catalog:",
    "tinyld": "^1.3.4",
    "undici": "^7.16.0",
    "winston": "^3.17.0",
    "ws": "^8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openstyle/sdk": "workspace:*",
    "@openstyle/utils": "workspace:*",
    "@openstyle/validations": "workspace:*",
    "@types/json-schema": "^7.0.15",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "pkgroll": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
