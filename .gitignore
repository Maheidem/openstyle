# Compiled native binaries (built locally and in CI)
apps/electron/resources/bin/

# SwiftPM build artifacts for the fluidaudio-diarize helper (dependency
# checkouts + compiled output — resources/bin/ above is the packaged copy).
apps/electron/native/fluidaudio-diarize/.build/

# Pre-bundled offline diarization models, fetched by compile-native.js
# (specs/meeting-diarization.md §4) — ~22MB, same idempotent-fetch treatment
# as resources/bin/ above, not committed.
apps/electron/resources/models/

# Local MLX ASR worker build artifacts
/.venv-mlx-asr/
/build/mlx_asr_worker/
**/mlx_asr_worker.spec

# Downloaded whisper.cpp binaries
apps/electron/resources/whisper/

# Test artifacts
test-results/

# Local-only env files (keep .env.example tracked)
.env
.env.local
.env.*.local
!.env.example

# Claude Code orchestrator-mode session/tool state (local-only, not project code)
.orchestrator-mode.*

# pi agent artifacts (local-only mesh/session state and exported session
# transcripts; root-anchored so no source path can match)
/.pi/
/pi-session-*.html

# Local agent handoffs and scratch notes
.scratchpad/

# Silver-gold eval (scripts/meeting-v2/eval/silver/README.md): the corpus,
# witness JSON, gold keys, arm DBs, audio, raw cloud responses and EG2 caches
# are private meeting data and stay outside the repo (~/.openstyle-eval/).
# These guards stop a copy that lands in the repo by mistake.
# 1. In the silver folder, only code and docs can be added; a data/ folder never.
/scripts/meeting-v2/eval/silver/**
!/scripts/meeting-v2/eval/silver/**/
!/scripts/meeting-v2/eval/silver/**/*.py
!/scripts/meeting-v2/eval/silver/**/*.mts
!/scripts/meeting-v2/eval/silver/**/*.sh
!/scripts/meeting-v2/eval/silver/**/*.md
/scripts/meeting-v2/eval/silver/**/data/
/scripts/meeting-v2/eval/silver/**/__pycache__/
# 2. Anywhere: meeting audio, SQLite DBs (app DB copies, arm DBs), EG2
#    vector caches and the private eval folders.
*.wav
*.mp3
*.m4a
*.flac
*.npz
*.db
*.db-wal
*.db-shm
*.sqlite
**/gold-silver/
**/.openstyle-eval/
